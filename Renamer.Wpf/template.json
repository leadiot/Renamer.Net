[
  {
    "name": "不变",
    "pattern": "<*><.><?>"
  },
  {
    "name": "文件名小写",
    "pattern": "<*|/><.><?>"
  },
  {
    "name": "文件名大写",
    "pattern": "<*|\\><.><?>"
  },
  {
    "name": "扩展名小写",
    "pattern": "<*><.><?|/>"
  },
  {
    "name": "扩展名大写",
    "pattern": "<*><.><?|\\>"
  },
  {
    "name": "文本替换",
    "pattern": "<*Abc|123><.><?>"
  },
  {
    "name": "全局流水",
    "pattern": "IMAGE_<|*4><.><?>"
  },
  {
    "name": "日期流水",
    "pattern": "<|\":yyyy-MM-dd>_<|*4><.><?>"
  }
]