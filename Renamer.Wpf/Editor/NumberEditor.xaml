<Window x:Class="Com.Scm.Renamer.Editor.NumberEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Width="420" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppCanvasBrush}"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="位宽（默认 0，不补齐；非零时，如不足则左侧补0）" Style="{StaticResource EditorLabel}"/>
            <hc:NumericUpDown Name="LenBox"/>
            <TextBlock Text="起始值（默认 1，仅支持正整数）" Style="{StaticResource EditorLabel}"/>
            <hc:NumericUpDown Name="StartBox"/>
            <TextBlock Text="步增量（默认 1，仅支持正整数）" Style="{StaticResource EditorLabel}"/>
            <hc:NumericUpDown Name="StepBox"/>
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <Button Content="确定"
                    Style="{StaticResource ButtonPrimary}"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="OkButton_Click"/>
            <Button Content="取消"
                    Style="{StaticResource ButtonDefault}"
                    Width="80"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
