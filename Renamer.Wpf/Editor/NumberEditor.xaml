<Window x:Class="Com.Scm.Renamer.Editor.NumberEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppCanvasBrush}"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="位宽（默认 0，不补齐；非零时，如不足则左侧补0）" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="LenBox" Margin="0,0,0,4"/>
        <TextBlock Text="起始值（默认 1，仅支持正整数）" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="StartBox" Margin="0,0,0,4"/>
        <TextBlock Text="步增量（默认 1，仅支持正整数）" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="StepBox" Margin="0,0,0,4"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="确定"
                    Style="{StaticResource ButtonPrimary}"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="OkButton_Click"/>
            <Button Content="取消"
                    Style="{StaticResource ButtonDefault}"
                    Width="80"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
