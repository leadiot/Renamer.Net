<Window x:Class="Com.Scm.Renamer.Editor.TimeEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppCanvasBrush}"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="时间来源" Style="{StaticResource EditorLabel}"/>
            <ComboBox x:Name="SrcBox">
                <ComboBoxItem Content="当前时间"/>
                <ComboBoxItem Content="创建时间"/>
                <ComboBoxItem Content="修改时间"/>
                <ComboBoxItem Content="访问时间"/>
            </ComboBox>
            <TextBlock Text="格式（留空 = yyyyMMddHHmmss）" Style="{StaticResource EditorLabel}"/>
            <TextBox x:Name="FmtBox" Margin="0,0,0,4"/>
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <Button
                Content="确定"
                Style="{StaticResource ButtonPrimary}"
                Width="80"
                Margin="0,0,8,0"
                Click="OkButton_Click"/>
            <Button
                Content="取消"
                Style="{StaticResource ButtonDefault}"
                Width="80"
                Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
