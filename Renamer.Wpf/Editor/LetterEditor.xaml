<Window x:Class="Com.Scm.Renamer.Editor.LetterEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource RegionBrush}"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        </Style>
        <Style x:Key="EditorCombo" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="字符集" Style="{StaticResource EditorLabel}"/>
        <ComboBox x:Name="SetBox" Style="{StaticResource EditorCombo}">
            <ComboBoxItem Content="小写字母 (a-z)"/>
            <ComboBoxItem Content="大写字母 (A-Z)"/>
            <ComboBoxItem Content="自定义字符集"/>
        </ComboBox>
        <TextBlock Text="自定义字符集（选择&quot;自定义字符集&quot;时生效）" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="CustomBox" Margin="0,0,0,4"/>
        <TextBlock Text="位宽（左侧补首字符，0 不补齐）" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="LenBox" Margin="0,0,0,4"/>
        <TextBlock Text="起始序数（默认 0）" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="StartBox" Margin="0,0,0,4"/>
        <TextBlock Text="步增量（默认 1，支持负）" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="StepBox" Margin="0,0,0,4"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="确定"
                    Style="{StaticResource ButtonPrimary}"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="OkButton_Click"/>
            <Button Content="取消"
                    Style="{StaticResource ButtonDefault}"
                    Width="80"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
