<Window x:Class="Renamer.Wpf.Editor.TextEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource AppFont}"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="固定文本" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="ContentBox"
                 Style="{StaticResource OutlinedTextBox}"
                 Margin="0,0,0,4"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="确定"
                    Style="{StaticResource FilledButton}"
                    Width="96"
                    Margin="0,16,8,0"
                    Click="OkButton_Click"/>
            <Button Content="取消"
                    Style="{StaticResource OutlinedButton}"
                    Width="96"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
