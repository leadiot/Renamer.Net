<UserControl x:Class="Com.Scm.Renamer.Editor.NameEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="操作" Style="{StaticResource EditorLabel}"/>
        <ComboBox x:Name="CbOpt" SelectionChanged="CbOpt_SelectionChanged">
            <ComboBoxItem Content="不变"/>
            <ComboBoxItem Content="转大写"/>
            <ComboBoxItem Content="转小写"/>
            <ComboBoxItem Content="截取"/>
            <ComboBoxItem Content="插入"/>
            <ComboBoxItem Content="删除"/>
            <ComboBoxItem Content="区间替换"/>
            <ComboBoxItem Content="文字替换"/>
        </ComboBox>
        <TextBlock Name="LbDir" Text="方向" Style="{StaticResource EditorLabel}"/>
        <ComboBox x:Name="CbDir">
            <ComboBoxItem Content="左起"/>
            <ComboBoxItem Content="右起"/>
        </ComboBox>
        <TextBlock Name="LbFrom" Text="起始位置" Style="{StaticResource EditorLabel}"/>
        <hc:NumericUpDown Name="TbFrom" Minimum="1"/>
        <TextBlock Name="LbTo" Text="结束位置" Style="{StaticResource EditorLabel}"/>
        <hc:NumericUpDown Name="TbTo" Minimum="1"/>
        <TextBlock Name="LbLength" Text="长度" Style="{StaticResource EditorLabel}"/>
        <hc:NumericUpDown Name="TbLength" Minimum="1"/>
        <TextBlock Name="LbSrc" Text="来源文本" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="TbSrc"/>
        <TextBlock Name="LbDst" Text="目标文本" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="TbDst"/>
    </StackPanel>
</UserControl>
