<UserControl x:Class="Com.Scm.Renamer.Editor.NameEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        </Style>
        <Style x:Key="EditorCombo" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EditorInput" TargetType="TextBox" BasedOn="{StaticResource OutlinedTextBox}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="大小写（优先级最高，选中后忽略下方操作）" Style="{StaticResource EditorLabel}"/>
        <ComboBox x:Name="CaseBox" Style="{StaticResource EditorCombo}">
            <ComboBoxItem Content="不变"/>
            <ComboBoxItem Content="转大写"/>
            <ComboBoxItem Content="转小写"/>
        </ComboBox>
        <TextBlock Text="操作" Style="{StaticResource EditorLabel}"/>
        <ComboBox x:Name="OpBox" Style="{StaticResource EditorCombo}">
            <ComboBoxItem Content="原样"/>
            <ComboBoxItem Content="截取"/>
            <ComboBoxItem Content="插入"/>
            <ComboBoxItem Content="删除"/>
            <ComboBoxItem Content="区间替换"/>
            <ComboBoxItem Content="文字替换"/>
        </ComboBox>
        <TextBlock Text="方向（位置操作用）" Style="{StaticResource EditorLabel}"/>
        <ComboBox x:Name="DirBox" Style="{StaticResource EditorCombo}">
            <ComboBoxItem Content="左起"/>
            <ComboBoxItem Content="右起"/>
        </ComboBox>
        <TextBlock Text="起始位置 From（1 基）" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="FromBox" Style="{StaticResource EditorInput}"/>
        <TextBlock Text="结束位置 To（截取/区间替换，1 基含端点）" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="ToBox" Style="{StaticResource EditorInput}"/>
        <TextBlock Text="长度 Length（删除）" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="LenBox" Style="{StaticResource EditorInput}"/>
        <TextBlock Text="源文本 SrcText（文字替换的被替换串）" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="SrcBox" Style="{StaticResource EditorInput}"/>
        <TextBlock Text="目标文本 DstText（插入/替换的目标串）" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="DstBox" Style="{StaticResource EditorInput}"/>
    </StackPanel>
</UserControl>
