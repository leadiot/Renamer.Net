<UserControl x:Class="Com.Scm.Renamer.Editor.NameEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="操作" Style="{StaticResource EditorLabel}"/>
        <ComboBox x:Name="OpBox" SelectionChanged="OpBox_SelectionChanged">
            <ComboBoxItem Content="不变"/>
            <ComboBoxItem Content="转大写"/>
            <ComboBoxItem Content="转小写"/>
            <ComboBoxItem Content="截取"/>
            <ComboBoxItem Content="插入"/>
            <ComboBoxItem Content="删除"/>
            <ComboBoxItem Content="区间替换"/>
            <ComboBoxItem Content="文字替换"/>
        </ComboBox>
        <TextBlock Text="方向（位置操作用）" Style="{StaticResource EditorLabel}"/>
        <ComboBox x:Name="DirBox">
            <ComboBoxItem Content="左起"/>
            <ComboBoxItem Content="右起"/>
        </ComboBox>
        <TextBlock Name="LbFrom" Text="起始位置 From（1 基）" Style="{StaticResource EditorLabel}"/>
        <hc:NumericUpDown Name="TbFrom" Minimum="1"/>
        <TextBlock Name="LbTo" Text="结束位置 To（截取/区间替换，1 基含端点）" Style="{StaticResource EditorLabel}"/>
        <hc:NumericUpDown Name="TbTo" Minimum="1"/>
        <TextBlock Name="LbLength" Text="长度 Length（删除）" Style="{StaticResource EditorLabel}"/>
        <hc:NumericUpDown Name="TbLength" Minimum="1"/>
        <TextBlock Name="LbSrc" Text="源文本 SrcText（文字替换的被替换串）" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="TbSrc"/>
        <TextBlock Name="LbDst" Text="目标文本 DstText（插入/替换的目标串）" Style="{StaticResource EditorLabel}"/>
        <TextBox x:Name="TbDst"/>
    </StackPanel>
</UserControl>
