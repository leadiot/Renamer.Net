<Window x:Class="Com.Scm.Renamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="批量重命名" Height="600" Width="900"
        Background="{StaticResource RegionBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 表达式输入栏 -->
        <Border Grid.Row="0"
                Background="{StaticResource SecondaryRegionBrush}"
                CornerRadius="12"
                Padding="20,14"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                <TextBlock Text="表达式"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
                <Button x:Name="ExpressionMenuButton"
                        Content="?"
                        Style="{StaticResource ButtonIconCircular}"
                        DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Click="ExpressionMenuButton_Click"/>
                <TextBox x:Name="ExpressionTextBox"
                         Height="32"
                         VerticalContentAlignment="Center"
                         FontFamily="{StaticResource MonoFont}"
                         Text="&lt;*&gt;&lt;.&gt;&lt;?&gt;"/>
            </DockPanel>
        </Border>

        <!-- 快捷表达式列表 -->
        <Grid Grid.Row="1" Margin="0,0,0,12"
              HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="+"
                    Style="{StaticResource ButtonPrimary}"
                    Margin="0,0,8,0"
                    Click="QuickTagAddStart_Click"/>
            <ItemsControl Grid.Column="1"
                          x:Name="QuickTagList"
                          VerticalAlignment="Center"
                          HorizontalContentAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6,8,0"
                              AllowDrop="True"
                              DragOver="QuickTagItem_DragOver"
                              DragLeave="QuickTagItem_DragLeave"
                              Drop="QuickTagItem_Drop">
                            <hc:Tag Content="{Binding Name}"
                                    ShowCloseButton="True"
                                    Selectable="False"
                                    VerticalAlignment="Center"
                                    ToolTip="点击编辑，拖动可排序"
                                    PreviewMouseLeftButtonUp="QuickTagItem_Edit"
                                    MouseRightButtonUp="QuickTagItem_RightClick"
                                    PreviewMouseLeftButtonDown="QuickTagItem_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="QuickTagItem_PreviewMouseMove"
                                    Closed="QuickTagItem_Delete"/>
                            <Rectangle x:Name="InsertBeforeBar"
                                       Width="3" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Stretch"
                                       Margin="-5,6,0,0"
                                       Visibility="Collapsed"/>
                            <Rectangle x:Name="InsertAfterBar"
                                       Width="3" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Stretch"
                                       Margin="0,6,-5,0"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Grid.Column="2"
                    Content="+"
                    Style="{StaticResource ButtonPrimary}"
                    Click="QuickTagAddEnd_Click"/>
        </Grid>

        <!-- 工具栏 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="AddFolderButton"
                        Content="添加目录"
                        Style="{StaticResource ButtonDefault}"
                        Margin="0,0,10,0"
                        Click="AddFolderButton_Click"/>
                <Button x:Name="AddFileButton"
                        Content="添加文件"
                        Style="{StaticResource ButtonDefault}"
                        Margin="0,0,10,0"
                        Click="AddFileButton_Click"/>
                <Button x:Name="RefreshPreviewButton"
                        Content="刷新预览"
                        Style="{StaticResource ButtonDefault}"
                        Margin="0,0,10,0"
                        Click="BtPreview_Click"/>
                <Button x:Name="ExecuteRenameButton"
                        Content="执行更名"
                        Style="{StaticResource ButtonPrimary}"
                        Click="ExecuteRenameButton_Click"/>
            </StackPanel>
            <Button x:Name="ExportButton"
                    Content="导出"
                    Style="{StaticResource ButtonDefault}"
                    HorizontalAlignment="Right"
                    Click="ExportButton_Click"/>
        </Grid>

        <!-- 结果表格 -->
        <DataGrid x:Name="ResultDataGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="原始名称" Binding="{Binding SrcName}" Width="2*"/>
                <DataGridTextColumn Header="结果名称" Binding="{Binding DstName}" Width="2*"/>
                <DataGridTextColumn Header="异常信息" Binding="{Binding IssueMessage}" Width="1.5*"/>
                <DataGridTextColumn Header="状态" Binding="{Binding ResultStatus}" Width="0.8*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultStatus}" Value="失败">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultStatus}" Value="跳过">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultStatus}" Value="已消解">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏 -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="已选择"
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SelectedCountText"
                           Text="0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Margin="4,0,4,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="个文件"
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Ctrl+R 刷新预览"
                       FontSize="13"
                       Foreground="{StaticResource ThirdlyTextBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
