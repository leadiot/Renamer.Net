<hc:Window
    x:Class="Com.Scm.Renamer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Com.Scm.Renamer.Convert"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    mc:Ignorable="d"
    Title="文件更名"
    Height="640" Width="920"
    Background="{StaticResource AppCanvasBrush}"
    ShowTitle="False"
    WindowStartupLocation="CenterScreen">
    <hc:Window.Resources>
        <Geometry x:Key="MenuGeometry">M3,5 H21 V7 H3 Z M3,11 H21 V13 H3 Z M3,17 H21 V19 H3 Z</Geometry>
        <ContextMenu x:Key="AppMenu">
            <MenuItem Header="关于" Click="MiAbout_Click"/>
            <MenuItem Header="项目首页" Click="MiHomepage_Click"/>
        </ContextMenu>
        <local:WidthOffsetConverter x:Key="WidthOffsetConverter"/>
    </hc:Window.Resources>

    <hc:Window.NonClientAreaContent>
        <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                <TextBlock Text="文件更名"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="基于表达式的文件批量更名工具"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="10,1,0,0"
                       Foreground="{StaticResource ThirdlyTextBrush}"/>
            </StackPanel>
            <Button x:Name="BtAppMenu"
                    Padding="8"
                    Style="{StaticResource ButtonIcon}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource MenuGeometry}"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    ToolTip="菜单"
                    Click="BtAppMenu_Click"/>
        </Grid>
    </hc:Window.NonClientAreaContent>

    <Grid Margin="22,20,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 表达式卡片 -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18,16"
                Margin="0,0,0,14">
            <DockPanel>
                <TextBlock
                    Text="表达式"
                    FontSize="13"
                    DockPanel.Dock="Left"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Margin="0,0,8,0"/>
                <Button
                    x:Name="BtMenu"
                    Content="?"
                    Style="{StaticResource ButtonIconCircular}"
                    hc:IconElement.Geometry="{StaticResource AddGeometry}"
                    DockPanel.Dock="Right"
                    Margin="12,0,0,0"
                    Click="BtMenu_Click"/>
                <TextBox
                    x:Name="TbText"
                    Height="38"
                    FontSize="14"
                    IsReadOnly="True"
                    VerticalContentAlignment="Center"
                    FontFamily="{StaticResource MonoFont}"
                    Text="&lt;*&gt;&lt;.&gt;&lt;?&gt;"/>
            </DockPanel>
        </Border>

        <!-- 快捷表达式列表 -->
        <Grid Grid.Row="1" Margin="0,0,0,14" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="+"
                    FontWeight="Bold"
                    Margin="0,0,8,0"
                    Style="{StaticResource ButtonPrimary}"
                    Click="QuickTagAddStart_Click"/>
            <ScrollViewer Grid.Column="1"
                          VerticalAlignment="Center"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WidthOffsetConverter}, ConverterParameter=170}">
                <ItemsControl x:Name="QuickTagList"
                              Height="48"
                              VerticalAlignment="Center"
                              HorizontalContentAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,0"
                                  AllowDrop="True"
                                  DragOver="QuickTagItem_DragOver"
                                  DragLeave="QuickTagItem_DragLeave"
                                  Drop="QuickTagItem_Drop">
                                <hc:Tag Content="{Binding Name}"
                                        ShowCloseButton="True"
                                        Selectable="False"
                                        VerticalAlignment="Center"
                                        ToolTip="点击编辑，拖动可排序"
                                        PreviewMouseLeftButtonUp="QuickTagItem_Edit"
                                        MouseRightButtonUp="QuickTagItem_RightClick"
                                        PreviewMouseLeftButtonDown="QuickTagItem_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="QuickTagItem_PreviewMouseMove"
                                        Closed="QuickTagItem_Delete"/>
                                <Rectangle x:Name="InsertBeforeBar"
                                           Width="3" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Stretch"
                                           Margin="-5,6,0,0"
                                           Visibility="Collapsed"/>
                                <Rectangle x:Name="InsertAfterBar"
                                           Width="3" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Stretch"
                                           Margin="0,6,-5,0"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button Grid.Column="2"
                    Content="+"
                    FontWeight="Bold"
                    Margin="8,0,0,0"
                    Style="{StaticResource ButtonPrimary}"
                    Click="QuickTagAddEnd_Click"/>
        </Grid>

        <!-- 工具栏 -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <hc:ButtonGroup>
                    <Button x:Name="BtAddDir"
                        Content="添加目录"
                        Style="{StaticResource ButtonDefault}"
                        Click="BtAddDir_Click"/>
                    <Button x:Name="BtAddDoc"
                        Content="添加文件"
                        Style="{StaticResource ButtonDefault}"
                        Click="BtAddDoc_Click"/>
                    <Button x:Name="BtClear"
                        Content="清空列表"
                        Style="{StaticResource ButtonDefault}"
                        Click="BtClear_Click"/>
                </hc:ButtonGroup>
                <Button x:Name="BtPreview"
                        Content="预览"
                        Style="{StaticResource ButtonPrimary}"
                        Margin="10,0,0,0"
                        Padding="20,0,20,0"
                        Click="BtPreview_Click"/>
                <Button x:Name="BtExecute"
                        Content="更名"
                        Margin="10,0,0,0"
                        Padding="20,0,20,0"
                        Style="{StaticResource ButtonDanger}"
                        Click="BtExecute_Click"/>
                <Border Width="1" Height="20" Margin="14,0,14,0"
                        Background="{StaticResource SecondaryBorderBrush}"
                        VerticalAlignment="Center"/>
                <ComboBox x:Name="CbNumberingOrder"
                          Width="118"
                          VerticalAlignment="Center"
                          ToolTip="流水发号顺序"
                          SelectionChanged="NumberingOption_Changed"/>
                <ComboBox x:Name="CbNumberingDirection"
                          Width="66"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          ToolTip="排序方向"
                          SelectionChanged="NumberingOption_Changed"/>
                <CheckBox x:Name="CbResetPerDir"
                          Content="按目录复位"
                          VerticalAlignment="Center"
                          Margin="10,0,0,0"
                          ToolTip="多目录批次各自从起始值发号"
                          Click="NumberingOption_Changed"/>
            </StackPanel>
            <Button x:Name="BtExport"
                    Content="导出"
                    Style="{StaticResource ButtonDefault}"
                    HorizontalAlignment="Right"
                    Click="BtExport_Click"/>
        </Grid>

        <!-- 结果卡片 -->
        <Border Grid.Row="3"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="4">
            <DataGrid x:Name="GdResult"
                          Background="Transparent"
                          BorderThickness="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="原始名称" Binding="{Binding SrcName}" Width="2*" CanUserSort="False"/>
                    <DataGridTextColumn Header="结果名称" Binding="{Binding DstName}" Width="2*" CanUserSort="False"/>
                    <DataGridTextColumn Header="异常信息" Binding="{Binding IssueMessage}" Width="1.5*" CanUserSort="False"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding ResultStatus}" Width="0.8*" CanUserSort="False">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultStatus}" Value="失败">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultStatus}" Value="跳过">
                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultStatus}" Value="已消解">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="操作" Width="70" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="删除"
                                            Style="{StaticResource ButtonDefault}"
                                            Padding="10,2"
                                            FontSize="12"
                                            Foreground="{StaticResource DangerBrush}"
                                            Click="DeleteRowButton_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 状态栏 -->
        <Grid Grid.Row="4" Margin="4,14,4,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="已选择"
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SelectedCountText"
                           Text="0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="4,0,4,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="个文件"
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Ctrl+R 刷新预览"
                       FontSize="13"
                       Foreground="{StaticResource ThirdlyTextBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</hc:Window>
