<Window x:Class="Renamer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Renamer.Wpf"
        mc:Ignorable="d"
        Title="批量重命名" Height="680" Width="1120"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 表达式输入栏 -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceVariantBrush}"
                CornerRadius="12"
                Padding="20,14"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                <TextBlock Text="表达式"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                <Button x:Name="ExpressionMenuButton"
                        Content="?"
                        Style="{StaticResource IconButton}"
                        DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Width="40" Height="40"
                        Click="ExpressionMenuButton_Click"/>
                <TextBox x:Name="ExpressionTextBox"
                         Style="{StaticResource OutlinedTextBox}"
                         Text="&lt;*&gt;&lt;.&gt;&lt;?&gt;"/>
            </DockPanel>
        </Border>

        <!-- 快捷标签 -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12">
            <Button Content="+" Tag="" Style="{StaticResource ChipButton}" Margin="0,0,8,0" Click="QuickTagAdd_Click"/>
            <Button Content="name" Tag="&lt;*&gt;" Style="{StaticResource ChipButton}" Margin="0,0,8,0" Click="QuickTag_Click"/>
            <Button Content="ext" Tag="&lt;?&gt;" Style="{StaticResource ChipButton}" Margin="0,0,8,0" Click="QuickTag_Click"/>
            <Button Content="index" Tag="&lt;|*3&gt;" Style="{StaticResource ChipButton}" Margin="0,0,8,0" Click="QuickTag_Click"/>
            <Button Content="date" Tag="&lt;|&quot;&gt;" Style="{StaticResource ChipButton}" Margin="0,0,8,0" Click="QuickTag_Click"/>
            <Button Content="sep" Tag="&lt;.&gt;" Style="{StaticResource ChipButton}" Click="QuickTag_Click"/>
        </StackPanel>

        <!-- 工具栏 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="AddFolderButton"
                        Content="添加目录"
                        Style="{StaticResource TonalButton}"
                        Margin="0,0,10,0"
                        Click="AddFolderButton_Click"/>
                <Button x:Name="AddFileButton"
                        Content="添加文件"
                        Style="{StaticResource TonalButton}"
                        Margin="0,0,10,0"
                        Click="AddFileButton_Click"/>
                <Button x:Name="RefreshPreviewButton"
                        Content="刷新预览"
                        Style="{StaticResource OutlinedButton}"
                        Margin="0,0,10,0"
                        Click="RefreshPreviewButton_Click"/>
                <Button x:Name="ExecuteRenameButton"
                        Content="执行更名"
                        Style="{StaticResource FilledButton}"
                        Click="ExecuteRenameButton_Click"/>
            </StackPanel>
            <Button x:Name="ExportButton"
                    Content="导出"
                    Style="{StaticResource OutlinedButton}"
                    HorizontalAlignment="Right"
                    Click="ExportButton_Click"/>
        </Grid>

        <!-- 结果表格 -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="12"
                Padding="0"
                Effect="{StaticResource Elevation1}"
                ClipToBounds="True">
            <DataGrid x:Name="ResultDataGrid"
                      Style="{StaticResource MaterialDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="原始名称" Binding="{Binding OriginalName}" Width="2*"/>
                    <DataGridTextColumn Header="结果名称" Binding="{Binding ResultName}" Width="2*"/>
                    <DataGridTextColumn Header="异常信息" Binding="{Binding ExceptionMessage}" Width="1.5*"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding ResultStatus}" Width="0.8*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultStatus}" Value="失败">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultStatus}" Value="跳过">
                                        <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultStatus}" Value="已消解">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 状态栏 -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="已选择"
                           FontSize="13"
                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SelectedCountText"
                           Text="0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource OnSurfaceBrush}"
                           Margin="4,0,4,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="个文件"
                           FontSize="13"
                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Ctrl+R 刷新预览"
                       FontSize="13"
                       Foreground="{StaticResource OutlineBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
